# Copy to `.env` and fill in real values. `.env` is git-ignored — never commit secrets.

PORT=5000
NODE_ENV=development

# MongoDB (Atlas connection string in production)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mentorlagbe

# Frontend origin(s) allowed by CORS / BetterAuth (comma separated, no trailing slash).
# The FIRST one is also used for Stripe success/cancel redirects.
CLIENT_URL=http://localhost:3000

# BetterAuth — BETTER_AUTH_URL is the public URL of THIS server
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-a-long-random-string-32+chars

# JWT used by the protected API (verifyToken / verifyStudent / verifyTutor / verifyAdmin)
JWT_SECRET=replace-with-another-long-random-string-32+chars
JWT_EXPIRES_IN=1d

# Stripe (test keys) — webhook secret comes from the Stripe dashboard or `stripe listen`
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ImgBB image hosting (https://api.imgbb.com/)
IMGBB_API_KEY=xxx

# Admin account created automatically on first boot / by `npm run seed`
ADMIN_EMAIL=admin@mentorlagbe.com
ADMIN_PASSWORD=Admin@123456
